<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ==================== GRANDPARENT: Spring Boot ==================== -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.4</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <!-- ==================== THÔNG TIN ROOT POM ==================== -->
    <groupId>com.example</groupId>
    <artifactId>mini-ecommerce-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>mini-ecommerce-parent</name>
    <description>Root Parent POM for Mini E-commerce Microservices</description>

    <!-- ==================== CÁC MODULE CON ==================== -->
    <modules>
        <module>my-library</module>
        <module>api-gateway</module>
        <module>auth-service</module>
        <module>notification-service</module>
        <module>order-service</module>
        <module>payment-service</module>
        <module>product-service</module>
        <module>user-service</module>
        <module>cart-service</module>
        <module>promotion-service</module>
        <module>dashboard-service</module>
    </modules>

    <!-- ==================== PHIÊN BẢN TẬP TRUNG ==================== -->
    <!-- Chỉ sửa version tại đây, tất cả module con sẽ tự động cập nhật -->
    <properties>
        <java.version>21</java.version>
        <spring-cloud.version>2023.0.1</spring-cloud.version>
        <lombok.version>1.18.42</lombok.version>
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <springdoc.version>2.5.0</springdoc.version>
        <jjwt.version>0.12.5</jjwt.version>
        <my-library.version>1.0.0</my-library.version>
        <feign.version>13.2.1</feign.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
    </properties>

    <!-- ==================== QUẢN LÝ PHIÊN BẢN DEPENDENCY ==================== -->
    <!-- Khai báo ở đây KHÔNG có nghĩa là các module con tự động dùng.         -->
    <!-- Module con phải tự khai báo dependency, nhưng KHÔNG cần ghi version.  -->
    <dependencyManagement>
        <dependencies>

            <!-- Spring Cloud BOM (quản lý toàn bộ phiên bản Spring Cloud) -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Thư viện dùng chung nội bộ -->
            <dependency>
                <groupId>com.example.lib</groupId>
                <artifactId>my-library</artifactId>
                <version>${my-library.version}</version>
            </dependency>

            <!-- SpringDoc OpenAPI (Swagger UI) cho MVC services -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- SpringDoc OpenAPI (Swagger UI) cho WebFlux (api-gateway) -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- SpringDoc OpenAPI Common (dùng trong my-library) -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-common</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- JWT -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>

            <!-- MapStruct -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>

            <!-- OpenFeign Core -->
            <dependency>
                <groupId>io.github.openfeign</groupId>
                <artifactId>feign-core</artifactId>
                <version>${feign.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

</project>